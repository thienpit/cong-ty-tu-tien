# ==== Cloud (OmniRoute) — 3 đệ tử Gemini ====
# base_url của OmniRoute (proxy local)
OMNI_BASE_URL=http://localhost:20128/v1
# Route thông minh của OmniRoute — mỗi đệ tử một route đúng chuyên môn
CLOUD_MODEL_MARKETING=auto/best-chat
CLOUD_MODEL_CODE=auto/best-coding
CLOUD_MODEL_DATA=auto/best-reasoning
# key OmniRoute (key trong .env của Hermes)
OMNI_API_KEY=sk-...

# ==== Local (Ollama) — GiamSat + việc vặt ====
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen3:8b
OLLAMA_API_KEY=ollama

# ==== Crew ====
# true = chạy chế độ có manager (tiểu đồ đứng giữa chia việc)
CREW_MANAGER=false
# số vòng lặp tối đa trước khi escalate
MAX_ITER=3
